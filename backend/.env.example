# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Option A – Single connection string (Neon, Supabase, Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/quickbite

# Option B – Individual fields (local Docker PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quickbite
DB_USER=postgres
DB_PASSWORD=your_password

# ── Auth ──────────────────────────────────────────────────────────────────────
# MUST be at least 32 characters. Generate with: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_minimum_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay (Test Mode) ──────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Gmail: Enable 2FA → App Passwords → generate a 16-character app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="QuickBite <noreply@quickbite.in>"
